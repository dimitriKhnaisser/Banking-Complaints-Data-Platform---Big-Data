# Copy to .env and replace every placeholder locally. Never commit .env.
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-local-password
MONGO_ROOT_USER=replace-with-local-mongodb-user
MONGO_ROOT_PASSWORD=replace-with-a-long-local-password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=raw
